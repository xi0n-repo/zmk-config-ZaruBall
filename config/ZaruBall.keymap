//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define ADJUST   4
#define SCROLL   2
#define UPPER    5

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&trackball_listener {
    input-processors = <
                         &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                         &zip_temp_layer MOUSE 600
    >;

    scroller {
        layers = <SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 20
                            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo 3>, <&mo 1>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo 3>, <&mo 1>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };

        baseAndS: baseAndS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <280>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
            label = "BASEANDS";
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 1>;

            label = "MKP_EXIT_AML";
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp GRAVE         &kp N1                  &kp N2                    &kp N3                      &kp N4                     &kp N5                                       &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                         &kp NUMBER_6  &kp N7  &kp N8     &kp N9                     &kp N0                      &kp EQUAL
&kp TAB           &kp Q                   &kp W                     &kp E                       &kp R                      &kp T                                        &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                       &kp Y         &kp U   &kp I      &kp O                      &kp P                       &kp MINUS
&kp LEFT_CONTROL  &baseAndS LEFT_SHIFT A  &baseAndS LEFT_CONTROL S  &kp D                       &kp F                      &kp G                    &kp LEFT_BRACKET    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp RIGHT_BRACKET  &kp H         &kp J   &kp K      &baseAndS RIGHT_CONTROL L  &baseAndS RIGHT_SHIFT SEMI  &kp SQT
&kp LSHFT         &lt 3 Z                 &lt 5 X                   &kp C                       &kp V                      &kp B                    &kp F14             &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp F15            &kp N         &kp M   &kp COMMA  &lt 5 PERIOD               &lt 2 SLASH                 &kp BACKSLASH
&kp LEFT_GUI      &kp C_MUTE                                        &baseAndS LEFT_CONTROL TAB  &baseAndS LEFT_ALT ESCAPE  &SandS LEFT_SHIFT SPACE  &mo 2                                                                       &lt 5 BACKSPACE    &lt 3 ENTER                                                                             &td1
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&to_layer_0 ESC   &to_layer_0 N1          &to_layer_0 N2            &to_layer_0 N3  &to_layer_0 N4  &to_layer_0 N5                    &trans  &trans  &trans  &trans                     &to_layer_0 N6  &to_layer_0 N7  &to_layer_0 N8     &to_layer_0 N9             &to_layer_0 N0                   &to_layer_0 EQUAL
&to_layer_0 TAB   &to_layer_0 Q           &to_layer_0 W             &to_layer_0 E   &to_layer_0 R   &to_layer_0 T                     &trans  &trans  &trans  &trans                     &to_layer_0 Y   &to_layer_0 U   &to_layer_0 I      &to_layer_0 O              &to_layer_0 P                    &to_layer_0 MINUS
&kp LEFT_CONTROL  &baseAndS LEFT_SHIFT A  &baseAndS LEFT_CONTROL S  &mkp RCLK       &mkp LCLK       &to_layer_0 G   &msc SCRL_UP      &trans  &trans  &trans  &trans    &msc SCRL_LEFT   &to_layer_0 H   &mkp LCLK       &mkp RCLK          &baseAndS RIGHT_CONTROL L  &baseAndS RIGHT_SHIFT SEMICOLON  &to_layer_0 SINGLE_QUOTE
&kp LSHIFT        &lt 3 Z                 &lt 5 X                   &to_layer_0 C   &to_layer_0 V   &to_layer_0 B   &msc SCRL_DOWN    &trans  &trans  &trans  &trans    &msc SCRL_RIGHT  &to_layer_0 N   &to_layer_0 M   &to_layer_0 COMMA  &lt 5 PERIOD               &lt 2 SLASH                      &to_layer_0 BACKSLASH
&trans            &trans                                            &trans          &trans          &trans          &trans                                              &trans           &trans                                                                                                         &trans
            >;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&kp ESCAPE  &none           &kp F2            &kp F3     &kp F4     &kp F5              &trans  &trans  &trans  &trans                &kp F6         &kp F7    &kp F8          &kp F9           &kp F10  &kp F12
&trans      &none           &none             &none      &none      &none               &trans  &trans  &trans  &trans                &none          &none     &kp UP_ARROW    &none            &none    &none
&trans      &kp LEFT_SHIFT  &kp LEFT_CONTROL  &mkp RCLK  &mkp LCLK  &none   &mkp MB4    &trans  &trans  &trans  &trans    &none       &kp PAGE_UP    &kp LEFT  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none    &none
&trans      &none           &none             &none      &none      &none   &mkp MB5    &trans  &trans  &trans  &trans    &none       &kp PAGE_DOWN  &kp HOME  &kp END         &none            &none    &none
&trans      &trans                            &trans     &trans     &trans  &trans                                        &kp DELETE  &trans                                                             &studio_unlock
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&kp ESCAPE  &none           &kp F2            &kp F3     &kp F4     &kp F5            &trans  &trans  &trans  &trans                &kp F6   &kp F7     &kp F8     &kp F9             &kp F10         &kp F12
&trans      &none           &kp F2            &kp F3     &kp F4     &kp F5            &trans  &trans  &trans  &trans                &kp F6   &kp F7     &kp F8     &kp F9             &kp F10         &kp F12
&trans      &kp LEFT_SHIFT  &kp LEFT_CONTROL  &mkp RCLK  &mkp LCLK  &none   &none     &trans  &trans  &trans  &trans    &none       &kp F12  &mkp LCLK  &mkp RCLK  &kp RIGHT_CONTROL  &kp LEFT_SHIFT  &none
&trans      &none           &none             &none      &none      &none   &none     &trans  &trans  &trans  &trans    &none       &none    &none      &none      &none              &none           &none
&trans      &trans                            &trans     &trans     &trans  &trans                                      &kp DELETE  &trans                                                            &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &trans              &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none                   &trans  &trans  &trans  &trans              &bt BT_CLR      &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_bat  &out OUT_TOG    &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_con  &studio_unlock  &none  &none  &none  &none  &none
&trans  &kp C_MUTE                  &trans        &trans        &trans        &trans                                      &trans    &trans                                      &trans
            >;
        };

        // Extra layer can be added in ZMK STUDIO

        upper_layer {
            display-name = "Upper";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESCAPE  &kp EXCLAMATION  &kp AT_SIGN       &kp HASH      &kp DOLLAR  &kp PERCENT              &trans  &trans  &trans  &trans                &kp LCTRL  &kp AMPERSAND     &kp ASTERISK       &kp LEFT_PARENTHESIS               &kp RIGHT_PARENTHESIS               &kp MINUS
&trans      &kp EXCLAMATION  &kp AT_SIGN       &kp HASH      &kp DOLLAR  &kp PERCENT              &trans  &trans  &trans  &trans                &kp LCTRL  &kp AMPERSAND     &kp ASTERISK       &kp LEFT_PARENTHESIS               &kp RIGHT_PARENTHESIS               &kp EQUAL
&trans      &kp LEFT_SHIFT   &kp LEFT_CONTROL  &kp MINUS     &kp EQUAL   &kp PAGE_UP    &none     &trans  &trans  &trans  &trans    &mkp MB4    &none      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &baseAndS RIGHT_CONTROL SEMICOLON  &baseAndS RIGHT_SHIFT SINGLE_QUOTE  &kp BACKSLASH
&trans      &none            &none             &kp HOME      &kp END     &kp PAGE_DOWN  &none     &trans  &trans  &trans  &trans    &mkp MB5    &none      &none             &none              &none                              &kp BACKSLASH                       &none
&trans      &trans                             &trans        &trans      &trans         &trans                                      &kp DELETE  &trans                                                                                                                 &studio_unlock
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans          &trans                                 &trans              &trans                   &trans                    &trans  &trans  &trans  &trans            &trans         &trans          &trans          &trans           &trans  &trans
&trans  &kp LC(LG(D))   &kp LG(LC(LEFT_ARROW))                 &kp LG(UP_ARROW)    &kp LC(LG(RIGHT_ARROW))  &trans                    &trans  &trans  &trans  &trans            &trans         &trans          &kp UP_ARROW    &trans           &trans  &trans
&trans  &kp LEFT_SHIFT  &baseAndS LEFT_CONTROL LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)      &trans          &trans    &trans  &trans  &trans  &trans    &trans  &kp PAGE_UP    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans          &trans                                 &trans              &trans                   &kp LC(LG(F4))  &trans    &trans  &trans  &trans  &trans    &trans  &kp PAGE_DOWN  &kp HOME        &kp END         &trans           &trans  &trans
&trans  &trans                                                 &trans              &trans                   &trans          &trans                                      &trans  &trans                                                                  &trans
            >;
        };

        number {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans  &trans  &trans  &trans                                      &trans  &trans                                  &trans
            >;
        };
    };
};
